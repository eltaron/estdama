@model List<TMS.Core.Entities.Courses.TrainingPlan>
@{
    ViewData["Title"] = @T["TrainingPlans.Title"];

    var statusBadge = new Dictionary<TMS.Core.Enums.PlanStatus, string>
    {
        [TMS.Core.Enums.PlanStatus.Draft] = "bg-secondary",
        [TMS.Core.Enums.PlanStatus.Approved] = "bg-primary",
        [TMS.Core.Enums.PlanStatus.Active] = "bg-success",
        [TMS.Core.Enums.PlanStatus.Closed] = "bg-dark"
    };

    var categoryName = new Dictionary<TMS.Core.Enums.TrainingPlanCategory, string>
    {
        [TMS.Core.Enums.TrainingPlanCategory.GovernmentAdmin] = T["TrainingPlans.AdminPlan"].Value,
        [TMS.Core.Enums.TrainingPlanCategory.Sapqar] = T["TrainingPlans.SapqarPlan"].Value,
        [TMS.Core.Enums.TrainingPlanCategory.ComputerScience] = T["TrainingPlans.ComputerSciencePlan"].Value
    };
    var current = ViewBag.CategoryFilter as TMS.Core.Enums.TrainingPlanCategory?;
}

<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6"><h1>@T["TrainingPlans.Title"]</h1></div>
            <div class="col-sm-6">
                <div class="float-end">
                    <a asp-action="Report" class="btn btn-info me-2"><i class="fas fa-file-alt"></i> @T["TrainingPlans.Report"]</a>
                    <a asp-action="Create" class="btn btn-primary"><i class="fas fa-plus"></i> @T["TrainingPlans.AddNew"]</a>
                </div>
            </div>
        </div>
    </div>
</div>

<section class="content">
    <div class="container-fluid">
        <div class="card">
            <div class="card-header p-0 pt-2">
                <ul class="nav nav-pills justify-content-center mb-0">
                    <li class="nav-item">
                        <a asp-action="Index" class="nav-link @(current == null ? "active" : "")">@T["TrainingPlans.All"]</a>
                    </li>
                    @foreach (var kv in categoryName)
                    {
                        <li class="nav-item">
                            <a asp-action="Index" asp-route-category="@((int)kv.Key)" class="nav-link @(current == kv.Key ? "active" : "")">@kv.Value</a>
                        </li>
                    }
                </ul>
            </div>
            <div class="card-body p-0">
                <table class="table table-bordered table-hover mb-0">
                    <thead>
                        <tr>
                            <th>@T["TrainingPlans.Name"]</th>
                            <th>@T["TrainingPlans.Type"]</th>
                            <th>@T["TrainingPlans.Year"]</th>
                            <th>@T["TrainingPlans.Quarter"]</th>
                            <th>@T["TrainingPlans.CourseCount"]</th>
                            <th>@T["Common.Status"]</th>
                            <th>@T["Common.Actions"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in Model)
                        {
                            <tr>
                                <td><strong>@p.NameAr</strong></td>
                                <td><span class="badge bg-secondary">@categoryName[p.Category]</span></td>
                                <td>@p.Year</td>
                                <td>@(p.Quarter.HasValue ? T["TrainingPlans.Quarter"].Value + " " + p.Quarter : "-")</td>
                                <td><span class="badge bg-info">@p.Items.Count</span></td>
                                <td><span class="badge @statusBadge[p.Status]">@p.Status</span></td>
                                <td>
                                    <a asp-action="Details" asp-route-id="@p.Id" class="btn btn-info btn-sm"><i class="fas fa-eye"></i></a>
                                </td>
                            </tr>
                        }
                        @if (!Model.Any())
                        {
                            <tr><td colspan="7" class="text-center text-muted py-4">@T["TrainingPlans.NoPlans"]</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</section>