@model TMS.Web.ViewModels.Registrations.RegistrationFormViewModel
@{
    ViewData["Title"] = @T["Registrations.AddNew"];
}

<div class="content-header">
    <div class="container-fluid"><h1>@T["Registrations.RegisterTrainee"]</h1></div>
</div>

<section class="content">
    <div class="container-fluid">
        <div class="card">
            <form asp-action="Create" method="post">
                <div class="card-body">
                    <div asp-validation-summary="All" class="text-danger"></div>
                    <div class="mb-3">
                        <label class="form-label">@T["Registrations.CourseSchedule"]</label>
                        <input type="text" value="@ViewBag.ScheduleName" class="form-control" disabled />
                        <input type="hidden" asp-for="CourseScheduleId" />
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="TraineeId" class="form-label">@T["Registrations.Trainee"]</label>
                                <select asp-for="TraineeId" asp-items="ViewBag.Trainees" class="form-control">
                                    <option value="">-- @T["Registrations.SelectTrainee"] --</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="Status" class="form-label">@T["Registrations.RegistrationStatus"]</label>
                                <select asp-for="Status" asp-items="ViewBag.Statuses" class="form-control"></select>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-4">
                            <div class="mb-3">
                                <label asp-for="FeeAmount" class="form-label">@T["Registrations.FeeWithDefault", ViewBag.DefaultFee?.ToString("N2")]</label>
                                <input asp-for="FeeAmount" type="number" step="0.01" class="form-control" />
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="mb-3">
                                <label asp-for="AmountPaid" class="form-label">@T["Registrations.AmountPaid"]</label>
                                <input asp-for="AmountPaid" type="number" step="0.01" class="form-control" />
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="mb-3">
                                <label asp-for="PaymentStatus" class="form-label">@T["Registrations.PaymentStatus"]</label>
                                <select asp-for="PaymentStatus" asp-items="ViewBag.PaymentStatuses" class="form-control"></select>
                            </div>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Notes" class="form-label">@T["Registrations.Notes"]</label>
                        <textarea asp-for="Notes" class="form-control" rows="2"></textarea>
                    </div>
                </div>
                <div class="card-footer">
                    <button type="submit" class="btn btn-primary"><i class="fas fa-user-plus"></i> @T["Registrations.Register"]</button>
                    <a asp-action="Index" asp-route-courseScheduleId="@Model.CourseScheduleId" class="btn btn-secondary">@T["Registrations.Cancel"]</a>
                </div>
            </form>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}