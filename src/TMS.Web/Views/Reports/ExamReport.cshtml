@model List<TMS.Web.ViewModels.Reports.ExamReportRow>
@using TMS.Core.Enums
@{
    ViewData["Title"] = @T["Reports.ExamsReport"];

    var isAr = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar";
}

<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6"><h1>@T["Reports.ExamsReport"]</h1></div>
            <div class="col-sm-6 text-end no-print">
                <a asp-action="Index" class="btn btn-secondary"><i class="fas fa-arrow-right"></i> @T["Common.Back"]</a>
                <button class="btn btn-brand" onclick="window.print()"><i class="fas fa-print"></i> @T["TrainingPlans.Print"]</button>
            </div>
        </div>
    </div>
</div>

<section class="content">
    <div class="container-fluid">

        <div class="card mb-3">
            <div class="card-header no-print">
                <h5 class="mb-0"><i class="fas fa-filter"></i> @T["TrainingPlans.Filter"]</h5>
            </div>
            <div class="card-body no-print">
                <form method="get" class="row g-2">
                    <div class="col-md-2">
                        <select name="categoryId" class="form-select">
                            <option value="">@T["Courses.AllCategories"]</option>
                            @foreach (var c in ViewBag.Categories)
                            {
                                <option value="@c.Value" selected="@(ViewBag.CategoryFilter?.ToString() == c.Value)">@c.Text</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-3">
                        <select name="courseId" class="form-select">
                            <option value="">@T["Reports.AllCourses"]</option>
                            @foreach (var c in ViewBag.Courses)
                            {
                                <option value="@c.Value" selected="@(ViewBag.CourseFilter?.ToString() == c.Value)">@c.Text</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-2">
                        <select name="year" class="form-select">
                            <option value="">@T["Reports.AllYears"]</option>
                            @foreach (int y in ViewBag.Years)
                            {
                                <option value="@y" selected="@(ViewBag.YearFilter?.ToString() == y.ToString())">@y</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-2">
                        <input type="date" name="from" value="@ViewBag.FromFilter" class="form-control" title="@T["Reports.From"]" />
                    </div>
                    <div class="col-md-2">
                        <input type="date" name="to" value="@ViewBag.ToFilter" class="form-control" title="@T["Reports.To"]" />
                    </div>
                    <div class="col-md-1">
                        <button type="submit" class="btn btn-primary"><i class="fas fa-search"></i></button>
                        <a asp-action="ExamReport" class="btn btn-secondary" title="@T["TrainingPlans.Reset"]"><i class="fas fa-undo"></i></a>
                        <button type="submit" name="export" value="excel" class="btn btn-success" title="@T["Exports.ExcelTitle"]"><i class="fas fa-file-excel"></i> @T["Exports.Excel"]</button>
                        <button type="submit" name="export" value="pdf" class="btn btn-danger" title="@T["Exports.PdfTitle"]"><i class="fas fa-file-pdf"></i> @T["Exports.Pdf"]</button>
                    </div>
                </form>
            </div>
        </div>

        <div class="card">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead>
                            <tr>
                                <th>@T["Reports.Course"]</th>
                                <th>@T["Exams.TitleLabel"]</th>
                                <th>@T["Exams.StartTime"]</th>
                                <th class="text-center">@T["Exams.TotalMarks"]</th>
                                <th class="text-center">@T["Exams.PassingMarks"]</th>
                                <th class="text-center">@T["Exams.SubmissionsCount"]</th>
                                <th class="text-center">@T["Reports.AvgScore"]</th>
                                <th class="text-center">@T["Reports.Passed"]</th>
                                <th class="text-center">@T["Reports.Failed"]</th>
                                <th class="text-center">@T["Reports.PassRate"]</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var r in Model)
                            {
                                var rateColor = r.PassRate >= 90 ? "bg-success" : (r.PassRate >= 75 ? "bg-warning" : "bg-danger");
                                <tr>
                                    <td>@r.CourseName</td>
                                    <td>@(isAr ? r.TitleAr : r.TitleEn)</td>
                                    <td>@(r.ExamDate?.ToString("yyyy-MM-dd"))</td>
                                    <td class="text-center">@(r.TotalMarks?.ToString() ?? "-")</td>
                                    <td class="text-center">@(r.PassingMarks?.ToString() ?? "-")</td>
                                    <td class="text-center">@r.Submissions</td>
                                    <td class="text-center">@r.AvgScore.ToString("0.0")</td>
                                    <td class="text-center">@r.Passed</td>
                                    <td class="text-center">@r.Failed</td>
                                    <td class="text-center"><span class="badge @rateColor">@r.PassRate%</span></td>
                                </tr>
                            }
                            @if (!Model.Any())
                            {
                                <tr><td colspan="10" class="text-center text-muted py-4">@T["Reports.NoResults"]</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</section>