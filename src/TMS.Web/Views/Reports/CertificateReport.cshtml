@model List<TMS.Core.Entities.Execution.Certificate>
@using TMS.Core.Enums
@{
    ViewData["Title"] = @T["Reports.CertificatesReport"];

    var isAr = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar";
}

<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6"><h1>@T["Reports.CertificatesReport"]</h1></div>
            <div class="col-sm-6 text-end no-print">
                <a asp-action="Index" class="btn btn-secondary"><i class="fas fa-arrow-right"></i> @T["Common.Back"]</a>
                <button class="btn btn-brand" onclick="window.print()"><i class="fas fa-print"></i> @T["TrainingPlans.Print"]</button>
            </div>
        </div>
    </div>
</div>

<section class="content">
    <div class="container-fluid">

        <div class="card mb-3">
            <div class="card-header no-print">
                <h5 class="mb-0"><i class="fas fa-filter"></i> @T["TrainingPlans.Filter"]</h5>
            </div>
            <div class="card-body no-print">
                <form method="get" class="row g-2">
                    <div class="col-md-2">
                        <select name="categoryId" class="form-select">
                            <option value="">@T["Courses.AllCategories"]</option>
                            @foreach (var c in ViewBag.Categories)
                            {
                                <option value="@c.Value" selected="@(ViewBag.CategoryFilter?.ToString() == c.Value)">@c.Text</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-3">
                        <select name="courseId" class="form-select">
                            <option value="">@T["Reports.AllCourses"]</option>
                            @foreach (var c in ViewBag.Courses)
                            {
                                <option value="@c.Value" selected="@(ViewBag.CourseFilter?.ToString() == c.Value)">@c.Text</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-2">
                        <select name="year" class="form-select">
                            <option value="">@T["Reports.AllYears"]</option>
                            @foreach (int y in ViewBag.Years)
                            {
                                <option value="@y" selected="@(ViewBag.YearFilter?.ToString() == y.ToString())">@y</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-2">
                        <input type="date" name="from" value="@ViewBag.FromFilter" class="form-control" title="@T["Reports.From"]" />
                    </div>
                    <div class="col-md-1">
                        <input type="date" name="to" value="@ViewBag.ToFilter" class="form-control" title="@T["Reports.To"]" />
                    </div>
                    <div class="col-md-2">
                        <input type="text" name="search" value="@ViewBag.SearchFilter" class="form-control" placeholder="@T["Certificates.SerialNumber"]" title="@T["Certificates.SerialNumber"]" />
                    </div>
                    <div class="col-md-3">
                        <button type="submit" class="btn btn-primary"><i class="fas fa-search"></i> @T["Common.Search"]</button>
                        <button type="submit" name="export" value="excel" class="btn btn-success" title="@T["Exports.ExcelTitle"]"><i class="fas fa-file-excel"></i> @T["Exports.Excel"]</button>
                        <button type="submit" name="export" value="pdf" class="btn btn-danger" title="@T["Exports.PdfTitle"]"><i class="fas fa-file-pdf"></i> @T["Exports.Pdf"]</button>
                    </div>
                </form>
            </div>
        </div>

        <div class="card">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead>
                            <tr>
                                <th>@T["Certificates.SerialNumber"]</th>
                                <th>@T["Certificates.Trainee"]</th>
                                <th>@T["Certificates.Course"]</th>
                                <th>@T["Certificates.IssueDate"]</th>
                                <th>@T["Common.Status"]</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var c in Model)
                            {
                                var valid = !c.IsRevoked;
                                <tr>
                                    <td><code>@c.SerialNumber</code></td>
                                    <td>@(isAr ? c.Trainee?.User?.FullNameAr : c.Trainee?.User?.FullNameEn)</td>
                                    <td>@(isAr ? c.CourseSchedule?.Course?.NameAr : c.CourseSchedule?.Course?.NameEn)</td>
                                    <td>@(c.IssueDate.ToShortDateString())</td>
                                    <td>
                                        @if (valid)
                                        {
                                            <span class="badge bg-success">@T["Certificates.Valid"]</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">@T["Certificates.Revoked"]</span>
                                        }
                                    </td>
                                </tr>
                            }
                            @if (!Model.Any())
                            {
                                <tr><td colspan="5" class="text-center text-muted py-4">@T["Reports.NoResults"]</td></tr>
                            }
                        </tbody>
                        @if (Model.Any())
                        {
                            <tfoot class="table-light">
                                <tr>
                                    <th colspan="4">@T["Reports.Total"] (@Model.Count)</th>
                                    <th>
                                        <span class="text-success">@T["Reports.StatusValid"]: @Model.Count(c => !c.IsRevoked)</span>
                                        <span class="text-danger ms-2">@T["Reports.StatusRevoked"]: @Model.Count(c => c.IsRevoked)</span>
                                    </th>
                                </tr>
                            </tfoot>
                        }
                    </table>
                </div>
            </div>
        </div>
    </div>
</section>