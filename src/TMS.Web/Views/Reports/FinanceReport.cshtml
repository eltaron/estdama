@model List<TMS.Web.ViewModels.Reports.FinanceReportRow>
@using TMS.Core.Enums
@{
    ViewData["Title"] = @T["Reports.FinanceReport"];

    var isAr = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar";

    var payName = new Dictionary<PaymentStatus, string>
    {
        [PaymentStatus.Pending] = T["Reports.PayPending"].Value,
        [PaymentStatus.Approved] = T["Reports.PayApproved"].Value,
        [PaymentStatus.Paid] = T["Registrations.PaymentPaid"].Value,
        [PaymentStatus.Partial] = T["Registrations.PaymentPartial"].Value,
        [PaymentStatus.Unpaid] = T["Registrations.PaymentUnpaid"].Value
    };

    var totalFees = Model.Sum(r => r.TotalFees);
    var totalPaid = Model.Sum(r => r.TotalPaid);
    var totalOutstanding = Model.Sum(r => r.Outstanding);
}

<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6"><h1>@T["Reports.FinanceReport"]</h1></div>
            <div class="col-sm-6 text-end no-print">
                <a asp-action="Index" class="btn btn-secondary"><i class="fas fa-arrow-right"></i> @T["Common.Back"]</a>
                <button class="btn btn-brand" onclick="window.print()"><i class="fas fa-print"></i> @T["TrainingPlans.Print"]</button>
            </div>
        </div>
    </div>
</div>

<section class="content">
    <div class="container-fluid">

        <div class="card mb-3">
            <div class="card-header no-print">
                <h5 class="mb-0"><i class="fas fa-filter"></i> @T["TrainingPlans.Filter"]</h5>
            </div>
            <div class="card-body no-print">
                <form method="get" class="row g-2">
                    <div class="col-md-2">
                        <select name="categoryId" class="form-select">
                            <option value="">@T["Courses.AllCategories"]</option>
                            @foreach (var c in ViewBag.Categories)
                            {
                                <option value="@c.Value" selected="@(ViewBag.CategoryFilter?.ToString() == c.Value)">@c.Text</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-3">
                        <select name="courseId" class="form-select">
                            <option value="">@T["Reports.AllCourses"]</option>
                            @foreach (var c in ViewBag.Courses)
                            {
                                <option value="@c.Value" selected="@(ViewBag.CourseFilter?.ToString() == c.Value)">@c.Text</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-2">
                        <select name="status" class="form-select">
                            <option value="">@T["Reports.AllStatuses"]</option>
                            @foreach (var kv in payName)
                            {
                                <option value="@((int)kv.Key)" selected="@(ViewBag.StatusFilter != null && (int)ViewBag.StatusFilter == (int)kv.Key)">@kv.Value</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-2">
                        <select name="year" class="form-select">
                            <option value="">@T["Reports.AllYears"]</option>
                            @foreach (int y in ViewBag.Years)
                            {
                                <option value="@y" selected="@(ViewBag.YearFilter?.ToString() == y.ToString())">@y</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-1">
                        <input type="date" name="from" value="@ViewBag.FromFilter" class="form-control" title="@T["Reports.From"]" />
                    </div>
                    <div class="col-md-1">
                        <input type="date" name="to" value="@ViewBag.ToFilter" class="form-control" title="@T["Reports.To"]" />
                    </div>
                    <div class="col-md-1">
                        <button type="submit" class="btn btn-primary"><i class="fas fa-search"></i></button>
                        <a asp-action="FinanceReport" class="btn btn-secondary" title="@T["TrainingPlans.Reset"]"><i class="fas fa-undo"></i></a>
                        <button type="submit" name="export" value="excel" class="btn btn-success" title="@T["Exports.ExcelTitle"]"><i class="fas fa-file-excel"></i> @T["Exports.Excel"]</button>
                        <button type="submit" name="export" value="pdf" class="btn btn-danger" title="@T["Exports.PdfTitle"]"><i class="fas fa-file-pdf"></i> @T["Exports.Pdf"]</button>
                    </div>
                </form>
            </div>
        </div>

        <div class="row g-2 mb-3">
            <div class="col-md-4">
                <div class="small-box bg-info">
                    <div class="inner"><h3>@totalFees?.ToString("N2")</h3><p>@T["Finance.TotalFees"]</p></div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="small-box bg-success">
                    <div class="inner"><h3>@totalPaid?.ToString("N2")</h3><p>@T["Reports.TotalPaid"]</p></div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="small-box bg-danger">
                    <div class="inner"><h3>@totalOutstanding?.ToString("N2")</h3><p>@T["Reports.TotalOutstanding"]</p></div>
                </div>
            </div>
        </div>

        <div class="card">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead>
                            <tr>
                                <th>@T["Reports.Course"]</th>
                                <th>@T["Reports.Period"]</th>
                                <th class="text-center">@T["Reports.RegisteredCount"]</th>
                                <th class="text-center">@T["Finance.Fees"]</th>
                                <th class="text-center">@T["Finance.Paid"]</th>
                                <th class="text-center">@T["Finance.Remaining"]</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var r in Model)
                            {
                                <tr>
                                    <td>@r.CourseName</td>
                                    <td>@(r.StartDate?.ToString("yyyy-MM-dd")) – @(r.EndDate?.ToString("yyyy-MM-dd"))</td>
                                    <td class="text-center">@r.Registrations</td>
                                    <td class="text-center">@(r.TotalFees?.ToString("N2") ?? "-")</td>
                                    <td class="text-center">@(r.TotalPaid?.ToString("N2") ?? "-")</td>
                                    <td class="text-center">@(r.Outstanding?.ToString("N2") ?? "-")</td>
                                </tr>
                            }
                            @if (!Model.Any())
                            {
                                <tr><td colspan="6" class="text-center text-muted py-4">@T["Reports.NoResults"]</td></tr>
                            }
                        </tbody>
                        @if (Model.Any())
                        {
                            <tfoot class="table-light">
                                <tr>
                                    <th colspan="3">@T["Reports.Total"]</th>
                                    <th class="text-center">@totalFees?.ToString("N2")</th>
                                    <th class="text-center">@totalPaid?.ToString("N2")</th>
                                    <th class="text-center">@totalOutstanding?.ToString("N2")</th>
                                </tr>
                            </tfoot>
                        }
                    </table>
                </div>
            </div>
        </div>
    </div>
</section>