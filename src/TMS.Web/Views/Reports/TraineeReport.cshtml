@model TMS.Web.ViewModels.Reports.TraineeReportViewModel
@using TMS.Core.Enums
@{
    ViewData["Title"] = @T["Reports.TraineesReport"];

    var isAr = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar";

    var gradeBadge = new Dictionary<string, string>
    {
        ["Reports.GradeExcellent"] = "bg-success",
        ["Reports.GradeVeryGood"] = "bg-primary",
        ["Reports.GradeGood"] = "bg-info",
        ["Reports.GradeAcceptable"] = "bg-warning",
        ["Reports.GradeFail"] = "bg-danger"
    };
}

<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6"><h1>@T["Reports.TraineesReport"]</h1></div>
            <div class="col-sm-6 text-end no-print">
                <a asp-action="Index" class="btn btn-secondary"><i class="fas fa-arrow-right"></i> @T["Common.Back"]</a>
                <button class="btn btn-brand" onclick="window.print()"><i class="fas fa-print"></i> @T["TrainingPlans.Print"]</button>
            </div>
        </div>
    </div>
</div>

<section class="content">
    <div class="container-fluid">

        <div class="card mb-3">
            <div class="card-header no-print">
                <h5 class="mb-0"><i class="fas fa-filter"></i> @T["TrainingPlans.Filter"]</h5>
            </div>
            <div class="card-body no-print">
                <form method="get" class="row g-2">
                    <div class="col-md-2">
                        <select name="categoryId" class="form-select">
                            <option value="">@T["Courses.AllCategories"]</option>
                            @foreach (var c in ViewBag.Categories)
                            {
                                <option value="@c.Value" selected="@(ViewBag.CategoryFilter?.ToString() == c.Value)">@c.Text</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-2">
                        <select name="traineeType" class="form-select">
                            <option value="">@T["Courses.AllCategories"]</option>
                            <option value="1" selected="@(ViewBag.TraineeTypeFilter?.ToString() == "1")">@T["Trainees.PrivateSector"]</option>
                            <option value="0" selected="@(ViewBag.TraineeTypeFilter?.ToString() == "0")">@T["Trainees.Government"]</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <select name="courseId" class="form-select">
                            <option value="">@T["Reports.AllCourses"]</option>
                            @foreach (var c in ViewBag.Courses)
                            {
                                <option value="@c.Value" selected="@(ViewBag.CourseFilter?.ToString() == c.Value)">@c.Text</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-2">
                        <select name="year" class="form-select">
                            <option value="">@T["Reports.AllYears"]</option>
                            @foreach (int y in ViewBag.Years)
                            {
                                <option value="@y" selected="@(ViewBag.YearFilter?.ToString() == y.ToString())">@y</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-1">
                        <input type="date" name="from" value="@ViewBag.FromFilter" class="form-control" title="@T["Reports.From"]" />
                    </div>
                    <div class="col-md-1">
                        <input type="date" name="to" value="@ViewBag.ToFilter" class="form-control" title="@T["Reports.To"]" />
                    </div>
                    <div class="col-md-1">
                        <button type="submit" class="btn btn-primary"><i class="fas fa-search"></i></button>
                        <a asp-action="TraineeReport" class="btn btn-secondary" title="@T["TrainingPlans.Reset"]"><i class="fas fa-undo"></i></a>
                        <button type="submit" name="export" value="excel" class="btn btn-success" title="@T["Exports.ExcelTitle"]"><i class="fas fa-file-excel"></i> @T["Exports.Excel"]</button>
                        <button type="submit" name="export" value="pdf" class="btn btn-danger" title="@T["Exports.PdfTitle"]"><i class="fas fa-file-pdf"></i> @T["Exports.Pdf"]</button>
                    </div>
                    <div class="col-md-12">
                        <input type="text" name="search" value="@ViewBag.SearchFilter" class="form-control" placeholder="@T["TrainingPlans.SearchPlaceholder"]" />
                    </div>
                </form>
            </div>
        </div>

        <div class="row g-2 mb-3">
            <div class="col-md-3">
                <div class="small-box bg-info">
                    <div class="inner"><h3>@Model.TotalTrainees</h3><p>@T["Reports.TotalTrainees"]</p></div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="small-box bg-primary">
                    <div class="inner"><h3>@Model.TotalCourses</h3><p>@T["Reports.TotalCourses"]</p></div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="small-box bg-success">
                    <div class="inner"><h3>@Model.PassRate%</h3><p>@T["Reports.PassRate"]</p></div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="small-box bg-warning">
                    <div class="inner"><h3>@Model.AvgScore.ToString("0.0")%</h3><p>@T["Reports.AvgScore"]</p></div>
                </div>
            </div>
        </div>

        <div class="row g-2 mb-3">
            <div class="col-md-4">
                <div class="card">
                    <div class="card-header"><h3 class="card-title">@T["Reports.ByCourseCategory"]</h3></div>
                    <div class="card-body p-0">
                        <table class="table table-hover mb-0">
                            <tbody>
                                @foreach (var c in Model.ByCategory)
                                {
                                    <tr>
                                        <td>@c.Name</td>
                                        <td class="text-end"><span class="badge bg-primary">@c.Count</span></td>
                                    </tr>
                                }
                                @if (!Model.ByCategory.Any())
                                {
                                    <tr><td colspan="2" class="text-center text-muted py-3">@T["Reports.NoData"]</td></tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card">
                    <div class="card-header"><h3 class="card-title">@T["Reports.ByTraineeType"]</h3></div>
                    <div class="card-body p-0">
                        <table class="table table-hover mb-0">
                            <tbody>
                                @foreach (var c in Model.ByTraineeType)
                                {
                                    <tr>
                                        <td>@T[c.Name].Value</td>
                                        <td class="text-end"><span class="badge bg-warning">@c.Count</span></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card">
                    <div class="card-header"><h3 class="card-title">@T["Reports.GradeDistribution"]</h3></div>
                    <div class="card-body p-0">
                        <table class="table table-hover mb-0">
                            <tbody>
                                @foreach (var c in Model.ByGrade)
                                {
                                    <tr>
                                        <td>
                                            @if (c.Name == "Reports.GradeExcellent" || c.Name == "Reports.GradeVeryGood" || c.Name == "Reports.GradeGood" || c.Name == "Reports.GradeAcceptable" || c.Name == "Reports.GradeFail")
                                            {
                                                <span class="badge @gradeBadge[c.Name]">@T[c.Name].Value</span>
                                            }
                                            else
                                            {
                                                <span class="text-muted">@T[c.Name].Value</span>
                                            }
                                        </td>
                                        <td class="text-end"><span class="badge bg-secondary">@c.Count</span></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <div class="card">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead>
                            <tr>
                                <th>@T["Registrations.Trainee"]</th>
                                <th>@T["Reports.CourseCategory"]</th>
                                <th>@T["Reports.TraineeType"]</th>
                                <th>@T["Reports.Course"]</th>
                                <th>@T["Reports.Grade"]</th>
                                <th>@T["Reports.Period"]</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var g in Model.Rows.GroupBy(r => r.TraineeId))
                            {
                                var first = true;
                                var gRows = g.ToList();
                                foreach (var r in gRows)
                                {
                                    <tr>
                                        @if (first)
                                        {
                                            first = false;
                                            <td rowspan="@gRows.Count">
                                                <strong>@(isAr ? r.TraineeNameAr : r.TraineeNameEn)</strong>
                                            </td>
                                        }
                                        <td>@(string.IsNullOrEmpty(r.CourseCategoryName) ? "-" : r.CourseCategoryName)</td>
                                        <td>
                                            @if (r.TraineeType == TraineeType.Private)
                                            {
                                                <span class="badge bg-info">@T["Trainees.PrivateSector"]</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary">@T["Trainees.Government"]</span>
                                            }
                                        </td>
                                        <td>@(isAr ? r.CourseNameAr : r.CourseNameEn)</td>
                                        <td>
                                            @if (r.HasGrade && r.GradeKey != null)
                                            {
                                                <span class="badge @gradeBadge[r.GradeKey]">@T[r.GradeKey].Value</span>
                                                <small class="ms-1 text-muted">@r.ScorePct.ToString("0.0")% (@r.Score.ToString("0.##")/@r.MaxScore.ToString("0.##"))</small>
                                            }
                                            else
                                            {
                                                <span class="text-muted">@T["Reports.NotGraded"]</span>
                                            }
                                        </td>
                                        <td>@(r.StartDate?.ToString("yyyy-MM-dd")) – @(r.EndDate?.ToString("yyyy-MM-dd"))</td>
                                    </tr>
                                }
                            }
                            @if (!Model.Rows.Any())
                            {
                                <tr><td colspan="6" class="text-center text-muted py-4">@T["Reports.NoResults"]</td></tr>
                            }
                        </tbody>
                        @if (Model.Rows.Any())
                        {
                            <tfoot class="table-light">
                                <tr>
                                    <th colspan="3">@T["Reports.Total"]</th>
                                    <th class="text-center">@Model.TotalCourses</th>
                                    <th class="text-center">@(Model.GradedCount > 0 ? T["Reports.Passed"].Value + ": " + Model.PassedCount + " | " + T["Reports.Failed"].Value + ": " + (Model.GradedCount - Model.PassedCount) : T["Reports.NotGraded"])</th>
                                    <th></th>
                                </tr>
                            </tfoot>
                        }
                    </table>
                </div>
            </div>
        </div>
    </div>
</section>