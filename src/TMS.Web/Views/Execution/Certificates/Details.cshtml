@model TMS.Core.Entities.Execution.Certificate
@{
    ViewData["Title"] = @T["Certificates.DetailsTitle", Model.SerialNumber];
}

<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6"><h1>@T["Certificates.TrainingCertificate"]</h1></div>
            <div class="col-sm-6 text-end">
                <a asp-action="Index" class="btn btn-secondary">@T["Common.Back"]</a>
                <a asp-action="DownloadPdf" asp-route-id="@Model.Id" class="btn btn-brand"><i class="fas fa-download"></i> @T["Certificates.Download"]</a>
                <button class="btn btn-info" onclick="window.print()"><i class="fas fa-print"></i> @T["Certificates.Print"]</button>
            </div>
        </div>
    </div>
</div>

<section class="content">
    <div class="container-fluid">
        <div class="card">
            <div class="card-body text-center py-5" style="border: 3px double #007bff;">
                @if (Model.IsRevoked)
                {
                    <span class="badge bg-danger mb-3">@T["Certificates.Revoked"]</span>
                }
                else
                {
                    <span class="badge bg-success mb-3">@T["Certificates.Valid"]</span>
                }
                <h2 style="color: #007bff;">@T["Certificates.CompletionTitle"]</h2>
                <hr style="width: 50%; margin: 20px auto;" />
                <p style="font-size: 1.2em;">@T["Certificates.CertifyThat"]</p>
                <h3>@Model.Trainee?.User?.FullNameAr</h3>
                <p>@T["Certificates.CompletedSuccessfully"]</p>
                <h4>@(Model.CourseSchedule?.Course?.NameAr ?? "")</h4>
                <p class="mt-3">
                    <strong>@T["Certificates.SerialNumber"]:</strong> @Model.SerialNumber<br />
                    <strong>@T["Certificates.IssueDate"]:</strong> @Model.IssueDate.ToString("yyyy-MM-dd")
                    @if (Model.ExpiryDate.HasValue)
                    {
                        <br /><strong>@T["Certificates.ExpiryDate"]:</strong> @Model.ExpiryDate.Value.ToString("yyyy-MM-dd")
                    }
                </p>
            </div>
        </div>

        @if (Model.IsRevoked)
        {
            <div class="alert alert-danger">
                <i class="fas fa-ban"></i> @T["Certificates.Revoked"]@(!string.IsNullOrEmpty(Model.RevocationReason) ? ": " + Model.RevocationReason : "")
            </div>
        }
        else
        {
            <div class="card">
                <div class="card-header"><h5 class="mb-0"><i class="fas fa-ban text-danger"></i> @T["Certificates.Revoke"]</h5></div>
                <div class="card-body">
                    <form asp-action="Revoke" asp-route-id="@Model.Id" method="post"
                          onsubmit="return confirm('@T["Certificates.RevokeConfirm"]');">
                        <div class="input-group" style="max-width: 560px;">
                            <input type="text" name="reason" class="form-control" placeholder="@T["Certificates.RevocationReason"]" />
                            <button type="submit" class="btn btn-danger"><i class="fas fa-ban"></i> @T["Certificates.Revoke"]</button>
                        </div>
                    </form>
                </div>
            </div>
        }

        @if (!string.IsNullOrEmpty(Model.IssuedBy?.FullNameAr))
        {
            <div class="text-end text-muted small">
                @T["Certificates.Issuer"]: @Model.IssuedBy.FullNameAr
            </div>
        }
    </div>
</section>

<style>
    @@media print {
        .main-header, .main-footer, .content-header .btn, .no-print { display: none !important; }
        body { background: #fff !important; }
    }
</style>