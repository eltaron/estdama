@{
    ViewData["Title"] = @T["Import.Title"];
}

<div class="content-header">
    <div class="container-fluid"><h1>@T["Import.ExcelTitle"]</h1></div>
</div>

<section class="content">
    <div class="container-fluid">
        <div class="card">
            <div class="card-body">
                <div class="alert alert-info">
                    <i class="fas fa-info-circle"></i>
                    @T["Import.Step1"]<br />
                    @T["Import.Step2"] = <code>Tms@@{@T["Import.EmployeeNumber"]}</code>.
                </div>

                <a asp-action="DownloadTemplate" class="btn btn-primary mb-3">
                    <i class="fas fa-download"></i> @T["Import.DownloadTemplate"]
                </a>

                <form asp-action="Import" method="post" enctype="multipart/form-data">
                    <div class="mb-3">
                        <input type="file" name="file" accept=".xlsx" class="form-control" />
                    </div>
                    <button type="submit" class="btn btn-success">
                        <i class="fas fa-upload"></i> @T["Import.Import"]
                    </button>
                </form>
            </div>
        </div>
    </div>
</section>