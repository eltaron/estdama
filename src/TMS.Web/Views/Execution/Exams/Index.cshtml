@model List<TMS.Core.Entities.Execution.Exam>
@{
    ViewData["Title"] = @T["Exams.Title"];
}

<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6"><h1>@T["Exams.Title"]</h1></div>
            <div class="col-sm-6">
                <div class="float-end">
                    <a asp-action="Create" class="btn btn-primary"><i class="fas fa-plus"></i> @T["Exams.Create"]</a>
                </div>
            </div>
        </div>
    </div>
</div>

<section class="content">
    <div class="container-fluid">
        <div class="card">
            <div class="card-body">
                <table class="table table-bordered table-hover">
                    <thead>
                        <tr>
                            <th>@T["Exams.TitleLabel"]</th>
                            <th>@T["Exams.Course"]</th>
                            <th>@T["Exams.Type"]</th>
                            <th>@T["Exams.Duration"]</th>
                            <th>@T["Exams.TotalMarks"]</th>
                            <th>@T["Exams.PassingMarks"]</th>
                            <th>@T["Exams.SubmissionsCount"]</th>
                            <th>@T["Common.Actions"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var e in Model)
                        {
                            <tr>
                                <td>@e.TitleAr</td>
                                <td>@(e.CourseSchedule?.Course?.NameAr ?? "-")</td>
                                <td>@e.Type</td>
                                <td>@e.DurationMinutes @T["Exams.Minutes"]</td>
                                <td>@e.TotalMarks</td>
                                <td>@e.PassingMarks</td>
                                <td>@e.Submissions.Count</td>
                                <td>
                                    <a asp-action="Details" asp-route-id="@e.Id" class="btn btn-info btn-sm"><i class="fas fa-eye"></i></a>
                                    @if (User.IsInRole("Admin") || User.IsInRole("Supervisor"))
                                    {
                                        <a asp-action="ManageQuestions" asp-route-id="@e.Id" class="btn btn-primary btn-sm" title="@T["Exams.ManageQuestions"]"><i class="fas fa-list"></i></a>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
                @if (!Model.Any())
                {
                    <div class="text-center text-muted py-4">@T["Exams.NoExams"]</div>
                }
            </div>
        </div>
    </div>
</section>