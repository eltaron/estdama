@model TMS.Web.ViewModels.Execution.TakeAttendanceViewModel
@{
    ViewData["Title"] = @T["Attendance.Record"];
}

<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1>@T["Attendance.Record"]</h1>
                <small class="text-muted">@Model.CourseName</small>
            </div>
            <div class="col-sm-6 text-end">
                <a asp-action="Index" class="btn btn-secondary">@T["Attendance.Log"]</a>
            </div>
        </div>
    </div>
</div>

<section class="content">
    <div class="container-fluid">

        <div class="card mb-3 no-print">
            <div class="card-header">
                <h5 class="mb-0"><i class="fas fa-qrcode"></i> @T["Attendance.QrTitle"]</h5>
            </div>
            <div class="card-body d-flex align-items-center gap-3">
                <div>
                    <img src="@Url.Action("AddQr", new { courseScheduleId = Model.CourseScheduleId, date = Model.Date.ToString("yyyy-MM-dd") })"
                         alt="QR" style="width:130px;height:130px" class="img-thumbnail" />
                </div>
                <div>
                    <p class="mb-1"><strong>@T["Attendance.QrHint"]</strong></p>
                    <p class="text-muted mb-0">@T["Attendance.QrText"]</p>
                </div>
            </div>
        </div>

        <form asp-action="Take" method="post">
            <input type="hidden" asp-for="CourseScheduleId" />
            <div class="row mb-3">
                <div class="col-md-4">
                    <label class="form-label">@T["Attendance.SessionDate"]</label>
                    <input asp-for="Date" class="form-control" type="date" />
                </div>
                <div class="col-md-8 d-flex align-items-end justify-content-end">
                    <button type="button" class="btn btn-outline-secondary me-1" onclick="setAll('Present')">@T["Attendance.AllPresent"]</button>
                    <button type="button" class="btn btn-outline-danger me-1" onclick="setAll('Absent')">@T["Attendance.AllAbsent"]</button>
                </div>
            </div>

            <div class="card">
                <div class="card-header">
                    <h3 class="card-title">@T["Attendance.RegisteredTrainees"] (@Model.Rows.Count)</h3>
                </div>
                <div class="card-body p-0">
                    @if (Model.Rows.Any())
                    {
                        <table class="table table-bordered table-hover mb-0" id="attendanceGrid">
                            <thead>
                                <tr>
                                    <th style="width:40px">#</th>
                                    <th>@T["Attendance.Trainee"]</th>
                                    <th>@T["Attendance.PreviousStatus"]</th>
                                    <th style="width:320px">@T["Common.Status"]</th>
                                    <th>@T["Attendance.Notes"]</th>
                                </tr>
                            </thead>
                            <tbody>
                                @for (int i = 0; i < Model.Rows.Count; i++)
                                {
                                    <tr>
                                        <td>@(i + 1)</td>
                                        <td>
                                            <strong>@Model.Rows[i].TraineeName</strong><br />
                                            <small class="text-muted">@(Model.Rows[i].EmployeeNumber ?? "-")</small>
                                            <input type="hidden" asp-for="Rows[i].TraineeId" />
                                        </td>
                                        <td>
                                            @if (Model.Rows[i].ExistingStatus.HasValue)
                                            {
                                                @switch (Model.Rows[i].ExistingStatus)
                                                {
                                                    case AttendanceStatus.Present:
                                                        <span class="badge bg-success">@T["Attendance.Present"]</span>
                                                        break;
                                                    case AttendanceStatus.Absent:
                                                        <span class="badge bg-danger">@T["Attendance.Absent"]</span>
                                                        break;
                                                    case AttendanceStatus.Excused:
                                                        <span class="badge bg-warning">@T["Attendance.Excused"]</span>
                                                        break;
                                                    case AttendanceStatus.Late:
                                                        <span class="badge bg-info">@T["Attendance.Late"]</span>
                                                        break;
                                                }
                                            }
                                            else
                                            {
                                                <span class="text-muted">-</span>
                                            }
                                        </td>
                                        <td>
                                            <select asp-for="Rows[i].Status" class="form-control form-control-sm status-select">
                                                <option value="Present">@T["Attendance.Present"]</option>
                                                <option value="Absent">@T["Attendance.Absent"]</option>
                                                <option value="Excused">@T["Attendance.Excused"]</option>
                                                <option value="Late">@T["Attendance.Late"]</option>
                                            </select>
                                        </td>
                                        <td>
                                            <input asp-for="Rows[i].Notes" class="form-control form-control-sm" />
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    else
                    {
                        <div class="text-center text-muted py-4">@T["Attendance.NoTrainees"]</div>
                    }
                </div>
                @if (Model.Rows.Any())
                {
                    <div class="card-footer">
                        <button type="submit" class="btn btn-success"><i class="fas fa-save"></i> @T["Attendance.SaveAttendance"]</button>
                        <a asp-action="Index" class="btn btn-secondary">@T["Attendance.Cancel"]</a>
                    </div>
                }
            </div>
        </form>
    </div>
</section>

@section Scripts {
    <script>
        function setAll(status) {
            $('#attendanceGrid .status-select').val(status);
        }
    </script>
}