@model List<TMS.Core.Entities.Execution.Attendance>
@{
    ViewData["Title"] = @T["Attendance.Title"];
}

<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6"><h1>@T["Attendance.RecordTitle"]</h1></div>
        </div>
    </div>
</div>

<section class="content">
    <div class="container-fluid">
        <div class="card">
            <div class="card-header">
                <form method="get" class="row g-2">
                    <div class="col-md-6">
                        <select name="courseScheduleId" asp-items="ViewBag.Schedules" class="form-control" onchange="this.form.submit()">
                            <option value="">@T["Attendance.SelectCourse"]</option>
                        </select>
                    </div>
                    <div class="col-md-2">
                        @if (ViewBag.SelectedScheduleId != null)
                        {
                            <a asp-action="Take" asp-route-courseScheduleId="@ViewBag.SelectedScheduleId" class="btn btn-success">
                                <i class="fas fa-clipboard-check"></i> @T["Attendance.Record"]
                            </a>
                        }
                    </div>
                </form>
            </div>
            <div class="card-body p-0">
                @if (Model.Any())
                {
                    <table class="table table-bordered table-hover mb-0">
                        <thead>
                            <tr>
                                <th>@T["Attendance.Date"]</th>
                                <th>@T["Attendance.Trainee"]</th>
                                <th>@T["Common.Status"]</th>
                                <th>@T["Attendance.CheckIn"]</th>
                                <th>@T["Attendance.CheckOut"]</th>
                                <th>@T["Attendance.Notes"]</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var a in Model)
                            {
                                <tr>
                                    <td>@a.Date.ToString("yyyy-MM-dd")</td>
                                    <td>@a.Trainee?.User?.FullNameAr</td>
                                    <td>
                                        @switch (a.Status)
                                        {
                                            case AttendanceStatus.Present:
                                                <span class="badge bg-success">@T["Attendance.Present"]</span>
                                                break;
                                            case AttendanceStatus.Absent:
                                                <span class="badge bg-danger">@T["Attendance.Absent"]</span>
                                                break;
                                            case AttendanceStatus.Excused:
                                                <span class="badge bg-warning">@T["Attendance.Excused"]</span>
                                                break;
                                            case AttendanceStatus.Late:
                                                <span class="badge bg-info">@T["Attendance.Late"]</span>
                                                break;
                                        }
                                    </td>
                                    <td>@(a.CheckInTime?.ToString(@"hh\:mm") ?? "-")</td>
                                    <td>@(a.CheckOutTime?.ToString(@"hh\:mm") ?? "-")</td>
                                    <td>@(a.Notes ?? "-")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <div class="text-center text-muted py-4">
                        @T["Attendance.EmptyState"]
                        <div class="mt-3">
                            <a asp-action="Take" class="btn btn-success"><i class="fas fa-clipboard-check"></i> @T["Attendance.Record"]</a>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</section>