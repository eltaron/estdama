@model List<TMS.Web.ViewModels.Instructors.InstructorListViewModel>
@{
    ViewData["Title"] = @T["Instructors.Title"];
}

<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1>@T["Instructors.Title"]</h1>
            </div>
            <div class="col-sm-6 text-end">
                <a asp-action="Create" class="btn btn-primary"><i class="fas fa-plus"></i> @T["Instructors.AddNew"]</a>
            </div>
        </div>
    </div>
</div>

<section class="content">
    <div class="container-fluid">
        <div class="card">
            <div class="card-header">
                <form method="get" class="row g-2">
                    <div class="col-md-4">
                        <input type="text" name="search" value="@ViewBag.Search" class="form-control" placeholder="@T["Instructors.SearchPlaceholder"]" />
                    </div>
                    <div class="col-md-3">
                        <select name="type" asp-items="ViewBag.TypeFilter" class="form-control">
                            <option value="">@T["Instructors.AllTypes"]</option>
                        </select>
                    </div>
                    <div class="col-md-2">
                        <button type="submit" class="btn btn-primary"><i class="fas fa-search"></i></button>
                    </div>
                </form>
            </div>
            <div class="card-body">
                <table class="table table-bordered table-hover">
                    <thead>
                        <tr>
                            <th>@T["Instructors.ArabicName"]</th>
                            <th>@T["Instructors.EnglishName"]</th>
                            <th>@T["Instructors.Specialization"]</th>
                            <th>@T["Instructors.Type"]</th>
                            <th>@T["Instructors.HourlyRate"]</th>
                            <th>@T["Common.Actions"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var i in Model)
                        {
                            <tr>
                                <td>@i.FullNameAr</td>
                                <td>@i.FullNameEn</td>
                                <td>@(i.SpecializationAr ?? "-")</td>
                                <td>
                                    @if (i.Type == TMS.Core.Enums.InstructorType.Internal)
                                    {
                                        <span class="badge bg-info">@T["Instructors.Internal"]</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-primary">@T["Instructors.External"]</span>
                                    }
                                </td>
                                <td>@i.HourlyRate.ToString("N2")</td>
                                <td>
                                    <a asp-action="Details" asp-route-id="@i.Id" class="btn btn-info btn-sm"><i class="fas fa-eye"></i></a>
                                    <a asp-action="Edit" asp-route-id="@i.Id" class="btn btn-warning btn-sm"><i class="fas fa-edit"></i></a>
                                    <form asp-action="Delete" asp-route-id="@i.Id" method="post" class="d-inline">
                                        <button type="submit" class="btn btn-danger btn-sm" onclick="return confirm('@T["Instructors.ConfirmDelete"]');"><i class="fas fa-trash"></i></button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
                @if (!Model.Any())
                {
                    <div class="text-center text-muted py-4">@T["Instructors.NoInstructors"]</div>
                }
            </div>
        </div>
    </div>
</section>
