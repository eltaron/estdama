@model TMS.Web.ViewModels.Reports.ConflictListViewModel
@{
    ViewData["Title"] = @T["Conflicts.Title"];
    var isAr = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar";
}

<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6"><h1>@T["Conflicts.Title"]</h1></div>
            <div class="col-sm-6 text-end no-print">
                <a asp-action="Index" asp-controller="Reports" class="btn btn-secondary"><i class="fas fa-arrow-right"></i> @T["Common.Back"]</a>
                <button class="btn btn-brand" onclick="window.print()"><i class="fas fa-print"></i> @T["TrainingPlans.Print"]</button>
            </div>
        </div>
    </div>
</div>

<section class="content">
    <div class="container-fluid">

        <div class="card mb-3">
            <div class="card-header no-print">
                <h5 class="mb-0"><i class="fas fa-filter"></i> @T["TrainingPlans.Filter"]</h5>
            </div>
            <div class="card-body no-print">
                <form method="get" class="row g-2">
                    <div class="col-md-3">
                        <label class="form-label mb-0">@T["Reports.From"]</label>
                        <input type="date" name="from" value="@ViewBag.FromFilter" class="form-control" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label mb-0">@T["Reports.To"]</label>
                        <input type="date" name="to" value="@ViewBag.ToFilter" class="form-control" />
                    </div>
                    <div class="col-md-3 d-flex align-items-end">
                        <button type="submit" class="btn btn-primary"><i class="fas fa-search"></i> @T["Common.Search"]</button>
                        <a asp-action="Index" class="btn btn-secondary ms-1" title="@T["TrainingPlans.Reset"]"><i class="fas fa-undo"></i></a>
                    </div>
                    <div class="col-md-3 d-flex align-items-end justify-content-end">
                        <span class="badge @(Model.Total == 0 ? "bg-success" : "bg-danger") fs-6">
                            @T["Conflicts.Total"]: @Model.Total
                        </span>
                    </div>
                </form>
            </div>
        </div>

        @if (Model.Total == 0)
        {
            <div class="alert alert-success">
                <i class="fas fa-check-circle"></i> @T["Conflicts.NoConflicts"]
            </div>
        }

        <div class="row">
            <div class="col-md-4">
                <div class="card card-outline card-danger">
                    <div class="card-header">
                        <h3 class="card-title"><i class="fas fa-chalkboard-teacher"></i> @T["Conflicts.InstructorSection"] (@Model.InstructorConflicts.Count)</h3>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-sm table-hover align-middle mb-0">
                                <thead>
                                    <tr>
                                        <th>@T["Conflicts.Resource"]</th>
                                        <th>@T["Conflicts.CourseA"]</th>
                                        <th>@T["Conflicts.TimesA"]</th>
                                        <th>@T["Conflicts.CourseB"]</th>
                                        <th>@T["Conflicts.TimesB"]</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var c in Model.InstructorConflicts)
                                    {
                                        <tr>
                                            <td class="text-danger"><strong>@c.ResourceName</strong></td>
                                            <td>@c.CourseAName</td>
                                            <td><small>@c.ScheduleATimes</small></td>
                                            <td>@c.CourseBName</td>
                                            <td><small>@c.ScheduleBTimes</small></td>
                                        </tr>
                                    }
                                    @if (!Model.InstructorConflicts.Any())
                                    {
                                        <tr><td colspan="5" class="text-center text-muted py-3">@T["Reports.NoResults"]</td></tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card card-outline card-warning">
                    <div class="card-header">
                        <h3 class="card-title"><i class="fas fa-building"></i> @T["Conflicts.RoomSection"] (@Model.RoomConflicts.Count)</h3>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-sm table-hover align-middle mb-0">
                                <thead>
                                    <tr>
                                        <th>@T["Conflicts.Resource"]</th>
                                        <th>@T["Conflicts.CourseA"]</th>
                                        <th>@T["Conflicts.TimesA"]</th>
                                        <th>@T["Conflicts.CourseB"]</th>
                                        <th>@T["Conflicts.TimesB"]</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var c in Model.RoomConflicts)
                                    {
                                        <tr>
                                            <td class="text-warning-emphasis"><strong>@c.ResourceName</strong></td>
                                            <td>@c.CourseAName</td>
                                            <td><small>@c.ScheduleATimes</small></td>
                                            <td>@c.CourseBName</td>
                                            <td><small>@c.ScheduleBTimes</small></td>
                                        </tr>
                                    }
                                    @if (!Model.RoomConflicts.Any())
                                    {
                                        <tr><td colspan="5" class="text-center text-muted py-3">@T["Reports.NoResults"]</td></tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card card-outline card-info">
                    <div class="card-header">
                        <h3 class="card-title"><i class="fas fa-tools"></i> @T["Conflicts.EquipmentSection"] (@Model.EquipmentConflicts.Count)</h3>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-sm table-hover align-middle mb-0">
                                <thead>
                                    <tr>
                                        <th>@T["Conflicts.Resource"]</th>
                                        <th>@T["Conflicts.CourseA"]</th>
                                        <th>@T["Conflicts.TimesA"]</th>
                                        <th>@T["Conflicts.CourseB"]</th>
                                        <th>@T["Conflicts.TimesB"]</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var c in Model.EquipmentConflicts)
                                    {
                                        <tr>
                                            <td class="text-info-emphasis"><strong>@c.EquipmentName</strong></td>
                                            <td>@c.CourseAName</td>
                                            <td><small>@c.LoanAPeriod</small></td>
                                            <td>@c.CourseBName</td>
                                            <td><small>@c.LoanBPeriod</small></td>
                                        </tr>
                                    }
                                    @if (!Model.EquipmentConflicts.Any())
                                    {
                                        <tr><td colspan="5" class="text-center text-muted py-3">@T["Reports.NoResults"]</td></tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>