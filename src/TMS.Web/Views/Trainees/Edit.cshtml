@model TMS.Web.ViewModels.Trainees.TraineeFormViewModel
@{
    ViewData["Title"] = @T["Trainees.Edit"];
}

<div class="content-header">
    <div class="container-fluid"><h1>@T["Trainees.Edit"]</h1></div>
</div>

<section class="content">
    <div class="container-fluid">
        <div class="card">
            <form asp-action="Edit" method="post">
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="UserId" />
                <div class="card-body">
                    <div asp-validation-summary="All" class="text-danger"></div>

                    <div class="row mb-3">
                        <div class="col-md-4">
                            <div class="mb-3">
                                <label asp-for="Type" class="form-label"></label>
                                <select asp-for="Type" asp-items="Html.GetEnumSelectList<TMS.Core.Enums.TraineeType>()" class="form-control" id="TraineeType"></select>
                            </div>
                        </div>
                        <div class="col-md-8">
                            <div class="alert alert-info mb-0 py-2 small">
                                <i class="fas fa-info-circle"></i> @T["Trainees.TypeInfoHint"]
                            </div>
                        </div>
                    </div>

                    <h5 class="mb-3"><i class="fas fa-user"></i> @T["Trainees.BasicData"]</h5>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="FullNameAr" class="form-label"></label>
                                <input asp-for="FullNameAr" class="form-control" />
                                <span asp-validation-for="FullNameAr" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="FullNameEn" class="form-label"></label>
                                <input asp-for="FullNameEn" class="form-control" />
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="NationalId" class="form-label"></label>
                                <input asp-for="NationalId" class="form-control" />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="Email" class="form-label"></label>
                                <input asp-for="Email" class="form-control" type="email" />
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="Phone" class="form-label"></label>
                                <input asp-for="Phone" class="form-control" />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="Address" class="form-label"></label>
                                <input asp-for="Address" class="form-control" />
                            </div>
                        </div>
                    </div>

                    <div id="GovFields">
                        <h5 class="mb-3"><i class="fas fa-building"></i> @T["Trainees.EmploymentData"]</h5>
                        <div class="row">
                            <div class="col-md-4">
                                <div class="mb-3">
                                    <label asp-for="Organization" class="form-label"></label>
                                    <input asp-for="Organization" class="form-control" />
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="mb-3">
                                    <label asp-for="Directorate" class="form-label"></label>
                                    <input asp-for="Directorate" class="form-control" />
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="mb-3">
                                    <label asp-for="JobGrade" class="form-label"></label>
                                    <input asp-for="JobGrade" class="form-control" />
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-4">
                                <div class="mb-3">
                                    <label asp-for="JobTitle" class="form-label"></label>
                                    <input asp-for="JobTitle" class="form-control" />
                                </div>
                            </div>
                        </div>
                    </div>

                    <div id="PrivateFields" style="display:none">
                        <div class="alert alert-secondary py-2 small">
                            <i class="fas fa-info-circle"></i> @T["Trainees.PrivateTypeHint"]
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-12">
                            <div class="mb-3">
                                <label asp-for="Notes" class="form-label"></label>
                                <textarea asp-for="Notes" class="form-control" rows="2"></textarea>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="card-footer">
                    <button type="submit" class="btn btn-primary"><i class="fas fa-save"></i> @T["Common.Save"]</button>
                    <a asp-action="Index" class="btn btn-secondary">@T["Trainees.Cancel"]</a>
                </div>
            </form>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        $(function () {
            function toggleType() {
                var isPrivate = $('#TraineeType').val() === '1';
                $('#GovFields').toggle(!isPrivate);
                $('#PrivateFields').toggle(isPrivate);
            }
            $('#TraineeType').on('change', toggleType);
            toggleType();
        });
    </script>
}