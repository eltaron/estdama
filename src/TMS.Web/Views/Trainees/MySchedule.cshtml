@model TMS.Core.Entities.Trainees.Trainee
@{
    ViewData["Title"] = @T["Trainees.MySchedule"];
}

<div class="content-header">
    <div class="container-fluid">
        <h1>@T["Trainees.MySchedule"]</h1>
    </div>
</div>

<section class="content">
    <div class="container-fluid">
        @if (Model == null)
        {
            <div class="alert alert-warning">@T["Trainees.NotLinkedHint"]</div>
        }
        else if (!Model.Registrations.Any())
        {
            <div class="card">
                <div class="card-body text-center text-muted py-4">@T["Trainees.NoScheduledCourses"]</div>
            </div>
        }
        else
        {
            <div class="row">
                @foreach (var reg in Model.Registrations)
                {
                    var s = reg.CourseSchedule;
                    <div class="col-md-6 mb-3">
                        <div class="card">
                            <div class="card-header">
                                <h5 class="card-title mb-0">@s.Course.NameAr</h5>
                            </div>
                            <div class="card-body">
                                <div class="mb-2">
                                    <strong>@T["Common.Status"]:</strong>
                                    @switch (reg.Status)
                                    {
                                        case RegistrationStatus.Registered:
                                            <span class="badge bg-primary">@T["Trainees.Registered"]</span>
                                            break;
                                        case RegistrationStatus.Confirmed:
                                            <span class="badge bg-success">@T["Trainees.Confirmed"]</span>
                                            break;
                                        case RegistrationStatus.Completed:
                                            <span class="badge bg-info">@T["Trainees.Completed"]</span>
                                            break;
                                        case RegistrationStatus.Dropped:
                                            <span class="badge bg-danger">@T["Trainees.Dropped"]</span>
                                            break;
                                        case RegistrationStatus.Waitlisted:
                                            <span class="badge bg-warning">@T["Trainees.Waitlisted"]</span>
                                            break;
                                    }
                                </div>
                                <div class="mb-2"><i class="fas fa-calendar"></i> @s.StartDate.ToString("yyyy-MM-dd") → @s.EndDate.ToString("yyyy-MM-dd")</div>
                                <div class="mb-2"><i class="fas fa-clock"></i> @s.StartTime - @s.EndTime</div>
                                @if (s.Instructor?.User != null)
                                {
                                    <div><i class="fas fa-user"></i> @T["Trainees.Instructor"]: @s.Instructor.User.FullNameAr</div>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</section>