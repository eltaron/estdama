@{
    ViewData["Title"] = @T["Title.AccessDenied"];
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="content-header">
    <div class="container-fluid"><h1>@T["Denied.NoAccess"]</h1></div>
</div>

<section class="content">
    <div class="container-fluid">
        <div class="card bg-danger text-white">
            <div class="card-body text-center py-5">
                <i class="fas fa-lock fa-3x mb-3"></i>
                <h3>@T["Denied.Message"]</h3>
                <p class="mb-4">@T["Denied.Hint"]</p>
                <a asp-controller="Dashboard" asp-action="Index" class="btn btn-light">
                    <i class="fas fa-home"></i> @T["Denied.BackHome"]
                </a>
            </div>
        </div>
    </div>
</section>