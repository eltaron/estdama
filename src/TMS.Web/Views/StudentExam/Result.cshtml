@model TMS.Core.Entities.Execution.ExamSubmission
@{
    ViewData["Title"] = @T["StudentExam.ResultTitle"];
}

<div class="content-header">
    <div class="container-fluid"><h1>@T["StudentExam.ResultTitle"]</h1></div>
</div>

<section class="content">
    <div class="container-fluid">
        <div class="card text-center">
            <div class="card-body">
                <h2>@Model.Exam.TitleAr</h2>
                <p class="text-muted">@Model.Trainee.User.FullNameAr</p>
                <hr />
                <h1 class="@(Model.IsPassed ? "text-success" : "text-danger")">@Model.TotalScore / @Model.Exam.TotalMarks</h1>
                @if (Model.IsPassed)
                {
                    <span class="badge bg-success fs-5">@T["StudentExam.Passed"]</span>
                }
                else
                {
                    <span class="badge bg-danger fs-5">@T["StudentExam.Failed"]</span>
                }
                <p class="mt-3 text-muted">@T["StudentExam.SubmitDate"]: @Model.SubmitTime?.ToString("yyyy-MM-dd HH:mm")</p>
                <a asp-action="Exams" asp-route-traineeId="@Model.TraineeId" asp-route-scheduleId="@Model.Exam.CourseScheduleId" class="btn btn-secondary mt-3">@T["StudentExam.BackToExams"]</a>
            </div>
        </div>
    </div>
</section>