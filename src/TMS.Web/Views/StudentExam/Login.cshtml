@model TMS.Web.ViewModels.Execution.StudentExamLoginViewModel
@{
    ViewData["Title"] = @T["StudentExam.LoginTitle"];
    Layout = "_Layout";
}

<div class="content-header">
    <div class="container-fluid">
        <h1>@T["StudentExam.LoginTitle"]</h1>
        <p class="text-muted">@T["StudentExam.LoginSubtitle"]</p>
    </div>
</div>

<section class="content">
    <div class="container-fluid">
        <div class="row justify-content-center">
            <div class="col-md-6">
                <div class="card">
                    <div class="card-body">
                        <div asp-validation-summary="All" class="text-danger"></div>
                        <form asp-action="Login" method="post">
                            <div class="mb-3">
                                <label asp-for="NationalId" class="form-label">@T["StudentExam.NationalId"]</label>
                                <input asp-for="NationalId" class="form-control" placeholder="@T["StudentExam.NationalIdPlaceholder"]" required />
                            </div>
                            <div class="mb-3">
                                <label asp-for="CourseCode" class="form-label">@T["StudentExam.CourseCode"]</label>
                                <input asp-for="CourseCode" class="form-control" placeholder="@T["StudentExam.CourseCodePlaceholder"]" required />
                                <small class="text-muted">@T["StudentExam.CourseCodeHint"]</small>
                            </div>
                            <button type="submit" class="btn btn-primary w-100"><i class="fas fa-sign-in-alt"></i> @T["StudentExam.Enter"]</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>