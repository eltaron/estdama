@model TMS.Web.ViewModels.Users.ResetPasswordViewModel
@{
    ViewData["Title"] = @T["Title.ResetPassword"];
}

<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6"><h1>@T["Title.ResetPassword"]</h1></div>
        </div>
    </div>
</div>

<section class="content">
    <div class="container-fluid">
        <div class="row justify-content-center">
            <div class="col-md-7">
                <form asp-action="ResetPassword" method="post">
                    <input type="hidden" asp-for="Id" />
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="card">
                        <div class="card-header"><h3 class="card-title"><i class="fas fa-key me-1"></i> @T["Common.NewPassword"]</h3></div>
                        <div class="card-body">
                            <div class="alert alert-info py-2">
                                <i class="fas fa-user me-1"></i> @T["Common.User"]: <strong>@Model.Email</strong>
                            </div>
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label asp-for="NewPassword" class="form-label"></label>
                                    <input asp-for="NewPassword" class="form-control" autocomplete="new-password" />
                                    <div class="form-text">@T["Common.PasswordHint"]</div>
                                    <span asp-validation-for="NewPassword" class="text-danger"></span>
                                </div>
                                <div class="col-md-6">
                                    <label asp-for="ConfirmPassword" class="form-label"></label>
                                    <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                                    <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between">
                        <a asp-action="Index" class="btn btn-outline-secondary"><i class="fas fa-arrow-right"></i> @T["Common.Back"]</a>
                        <button type="submit" class="btn btn-primary"><i class="fas fa-redo"></i> @T["Common.ResetPassword"]</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}