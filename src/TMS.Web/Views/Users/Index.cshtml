@model List<TMS.Web.ViewModels.Users.UserListViewModel>
@{
    ViewData["Title"] = @T["Title.Users"];
}

<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6"><h1>@T["Title.Users"]</h1></div>
            <div class="col-sm-6">
                <div class="float-end">
                    @if (User.Can("users", Perm.Create))
                    {
                        <a asp-action="Create" class="btn btn-primary"><i class="fas fa-plus"></i> @T["Users.AddNew"]</a>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<section class="content">
    <div class="container-fluid">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title"><i class="fas fa-users me-1"></i> @T["Users.Manage"]</h3>
                <div class="card-tools">
                    <span class="badge bg-info">@Model.Count @T["Users.Count"]</span>
                </div>
            </div>
            <div class="card-body">
                <form method="get" asp-action="Index" class="row g-3 mb-3">
                    <div class="col-md-5">
                        <input type="text" name="search" value="@ViewBag.Search" class="form-control" placeholder="@T["Users.SearchPlaceholder"]" />
                    </div>
                    <div class="col-md-4">
                        <select name="roleId" asp-items="@((SelectList)ViewBag.Roles)" class="form-select">
                            <option value="">@T["Users.AllRoles"]</option>
                        </select>
                    </div>
                    <div class="col-md-3 d-flex gap-2">
                        <button type="submit" class="btn btn-primary"><i class="fas fa-search me-1"></i> @T["Common.Search"]</button>
                        <a asp-action="Index" class="btn btn-outline-secondary"><i class="fas fa-undo me-1"></i></a>
                    </div>
                </form>

                <div class="table-responsive">
                    <table class="table table-bordered table-hover mb-0">
                        <thead>
                            <tr>
                                <th>@T["Users.Name"]</th>
                                <th>@T["Common.Email"]</th>
                                <th>@T["Users.EmployeeNumber"]</th>
                                <th>@T["Common.Department"]</th>
                                <th>@T["Common.Role"]</th>
                                <th>@T["Common.Status"]</th>
                                <th>@T["Common.Actions"]</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var user in Model)
                            {
                                <tr>
                                    <td>
                                        <strong>@user.FullNameAr</strong>
                                        <div class="text-muted small">@user.FullNameEn</div>
                                        @if (!string.IsNullOrEmpty(user.JobTitle))
                                        {
                                            <div class="text-muted small">@user.JobTitle</div>
                                        }
                                    </td>
                                    <td>@user.Email</td>
                                    <td>@(user.EmployeeNumber ?? "-")</td>
                                    <td>@(user.DepartmentName ?? "-")</td>
                                    <td><span class="badge bg-primary">@user.RoleNameAr</span></td>
                                    <td>
                                        @if (user.IsActive)
                                        {
                                            <span class="badge bg-success">@T["Common.Active"]</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">@T["Common.Inactive"]</span>
                                        }
                                    </td>
                                    <td class="d-flex gap-1 flex-wrap">
                                        @if (User.Can("users", Perm.Edit))
                                        {
                                            <a asp-action="Edit" asp-route-id="@user.Id" class="btn btn-info btn-sm" title="@T["Common.Edit"]"><i class="fas fa-edit"></i></a>
                                            <a asp-action="ResetPassword" asp-route-id="@user.Id" class="btn btn-warning btn-sm" title="@T["Common.ResetPassword"]"><i class="fas fa-key"></i></a>
                                            <form asp-action="ToggleActive" asp-route-id="@user.Id" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn @(user.IsActive ? "btn-secondary" : "btn-success") btn-sm"
                                                        title="@(user.IsActive ? T["Common.Disable"] : T["Common.Enable"])">
                                                    <i class="fas @(user.IsActive ? "fa-ban" : "fa-check-circle")"></i>
                                                </button>
                                            </form>
                                        }
                                    </td>
                                </tr>
                            }
                            @if (!Model.Any())
                            {
                                <tr><td colspan="7" class="text-center text-muted py-4">@T["Common.NoResults"]</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</section>